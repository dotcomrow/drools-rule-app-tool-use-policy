<?xml version="1.0" encoding="UTF-8"?>
<!--
  Business Central (Workbench) uses this file for the Deployment Descriptor editor.
  Keep this structure compatible with the Workbench version in the cluster (7.74.x).
-->
<deployment-descriptor
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.jboss.org/jbpm deployment-descriptor.xsd">
  <!-- KIE execution is stateless. The optional datasource below is explicitly
       application-owned persistence and is independent of KIE session state. -->
  <audit-mode>NONE</audit-mode>
  <persistence-mode>NONE</persistence-mode>
  <runtime-strategy>PER_REQUEST</runtime-strategy>

  <!-- Placeholders: keep empty, then add entries as needed. -->
  <marshalling-strategies />
  <event-listeners />
  <task-event-listeners />
  <globals />
  <work-item-handlers />
  <environment-entries />
  <configurations />
  <required-roles />
</deployment-descriptor>
